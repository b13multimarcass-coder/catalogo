rules_version = '2';
// Regras do catálogo B13.
// Público: lê produtos, fotos e dados da loja; só pode somar +1 em visitas e cliques.
// Lojista: quem tiver um documento em admins/{uid} (criado à mão no console).
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /config/{doc}   { allow read: if true; allow write: if admin(); }
    match /produtos/{id}  { allow read: if true; allow write: if admin(); }
    match /fotos/{id}     { allow read: if true; allow write: if admin(); }

    // custo fica separado do produto para o cliente nunca ver
    match /priv/{id}       { allow read, write: if admin(); }
    match /movimentos/{id} { allow read, write: if admin(); }
    // dados do remetente da etiqueta (CPF/CNPJ, endereço)
    match /interno/{doc}   { allow read, write: if admin(); }
    match /admins/{uid}    { allow read: if request.auth != null && request.auth.uid == uid; }

    // pedidos do site: só o servidor (conta de serviço, que não passa por estas regras) cria;
    // o lojista lê e muda o andamento (enviado, entregue, cancelado)
    match /pedidos/{id}    { allow read, update: if admin(); allow create, delete: if false; }

    match /stats/{id} {
      allow read: if admin();
      allow delete: if admin();
      allow create: if request.resource.data.keys().hasOnly(['views', 'whats'])
        && request.resource.data.values().hasOnly([1]);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'whats'])
        && (!('views' in request.resource.data) || request.resource.data.views == resource.data.get('views', 0) + 1 || request.resource.data.views == resource.data.get('views', 0))
        && (!('whats' in request.resource.data) || request.resource.data.whats == resource.data.get('whats', 0) + 1 || request.resource.data.whats == resource.data.get('whats', 0));
    }
  }
}
